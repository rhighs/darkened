{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["purple", "blue", "green", "orange", "red"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$hue.neutral.900",
          "$disabled": "$hue.neutral.500",
          "$focused": "$hue.neutral.900",
          "$selected": "$hue.neutral.900"
        },
        "secondary": {
          "base": "$hue.neutral.500",
          "$hovered": "$hue.neutral.200",
          "$focused": "$hue.neutral.200",
          "$selected": "$hue.purple.300",
          "$disabled": "$hue.neutral.600"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$hue.neutral.500"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.purple.300",
        "$focused": "$hue.purple.300",
        "$pressed": "$hue.purple.300",
        "$disabled": "$hue.neutral.500",
        "$selected": "$hue.purple.300"
      },
      "feedback": {
        "error": { "base": "$hue.red.200" },
        "warning": { "base": "$hue.orange.200" },
        "success": { "base": "$hue.green.200" },
        "info": { "base": "$hue.cyan.200" }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "$hue.purple.400",
          "$hovered": "#a786ff",
          "$focused": "$hue.purple.300",
          "$pressed": "$hue.purple.500",
          "$selected": "$hue.purple.400",
          "$disabled": "$hue.neutral.700"
        },
        "secondary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.800"
        },
        "destructive": {
          "base": "$hue.red.200",
          "$hovered": "#e37797",
          "$disabled": "$hue.neutral.700"
        }
      },
      "formfield": {
        "base": "$hue.neutral.800",
        "$hovered": "$hue.neutral.700",
        "$focused": "$hue.neutral.700",
        "$selected": "$hue.neutral.700",
        "$disabled": "$hue.neutral.800"
      },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "$hue.neutral.600" },
    "scrollbar": { "base": "#2b2b2b" },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.300",
        "hunkHeader": "$hue.blue.300"
      },
      "background": {
        "added": "#0a1a06",
        "removed": "#1f0a11",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.100",
        "removed": "$hue.red.100"
      },
      "lineNumber": {
        "text": "$hue.neutral.500",
        "background": {
          "added": "#071303",
          "removed": "#16070c"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.300",
      "keyword": "$hue.blue.300",
      "function": "$hue.neutral.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.purple.200",
      "number": "$hue.yellow.200",
      "type": "$hue.purple.300",
      "operator": "$hue.cyan.200",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.purple.300",
      "link": "$hue.blue.300",
      "linkText": "$hue.cyan.200",
      "code": "$hue.purple.200",
      "blockQuote": "$hue.neutral.300",
      "emphasis": "$hue.red.100",
      "strong": "$hue.green.200",
      "horizontalRule": "$hue.neutral.500",
      "listItem": "$hue.purple.400",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.blue.300",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": { "$hovered": "$background.raised.high" }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#e8ecf3",
        "200": "#bec7d1",
        "300": "#8784ad",
        "400": "#6b6890",
        "500": "#4e4c78",
        "600": "#333333",
        "700": "#262626",
        "800": "#1a1a1a",
        "900": "#000000"
      },
      "red": {
        "100": "#d787af",
        "200": "#db6088",
        "300": "#b8546f",
        "400": "#94425a",
        "500": "#723147",
        "600": "#522135",
        "700": "#351424",
        "800": "#1c0914",
        "900": "#0a0206"
      },
      "orange": {
        "100": "#ffd9b3",
        "200": "#f5a742",
        "300": "#d98b2c",
        "400": "#b8711f",
        "500": "#945715",
        "600": "#703f0d",
        "700": "#4d2a07",
        "800": "#2b1703",
        "900": "#120801"
      },
      "yellow": {
        "100": "#f5f3a8",
        "200": "#dedc52",
        "300": "#bfbd3f",
        "400": "#9e9c2e",
        "500": "#7d7b20",
        "600": "#5c5b14",
        "700": "#3d3c0b",
        "800": "#201f04",
        "900": "#0c0b01"
      },
      "green": {
        "100": "#cdf5b0",
        "200": "#9cda7c",
        "300": "#7bc45c",
        "400": "#5fa544",
        "500": "#47832f",
        "600": "#32631f",
        "700": "#204612",
        "800": "#102b07",
        "900": "#051400"
      },
      "cyan": {
        "100": "#b8f0e6",
        "200": "#7fd6c2",
        "300": "#5cb8a4",
        "400": "#419a87",
        "500": "#2c7c6b",
        "600": "#1c5e50",
        "700": "#104138",
        "800": "#072622",
        "900": "#010e0c"
      },
      "blue": {
        "100": "#c9ddf5",
        "200": "#a8c8ee",
        "300": "#7ca8de",
        "400": "#5d8ac4",
        "500": "#436ca3",
        "600": "#2e5281",
        "700": "#1d3a60",
        "800": "#0f2541",
        "900": "#041225"
      },
      "purple": {
        "100": "#e2cdfa",
        "200": "#cfa1ed",
        "300": "#b968fc",
        "400": "#875FAF",
        "500": "#6e4b92",
        "600": "#573a75",
        "700": "#402a58",
        "800": "#2b1c3c",
        "900": "#180f22"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.purple",
      "neutral": "$hue.gray"
    }
  }
}
