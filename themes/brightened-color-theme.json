    "tokenColors": [
        {
            "scope": "comment",
            "settings": {
                "foreground": "#7a7490"
            }
        },
        {
            "scope": "string",
            "settings": {
                "foreground": "#6f4c93"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#2f2b3b"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#2c659b"
            }
        },
        {
            "scope": "constant.numeric",
            "settings": {
                "foreground": "#8a7715"
            }
        },
        {
            "scope": "entity.name.function",
            "settings": {
                "foreground": "#2f2b3b"
            }
        },
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#a3263f",
                "background": "#fae6ea"
            }
        },
        {
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#2e7033"
            }
        },
        {
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#a3263f"
            }
        },
        {
            "scope": "markup.changed",
            "settings": {
                "foreground": "#b8567a"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#875FAF"
            }
        },
        {
            "scope": "entity.name.section",
            "settings": {
                "foreground": "#a3263f"
            }
        },
        {
            "scope": ["storage.type", "storage.modifier"],
            "settings": {
                "foreground": "#875FAF"
            }
        },
        {
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#2f2b3b"
            }
        }
    ]
}
